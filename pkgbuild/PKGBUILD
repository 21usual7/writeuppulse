pkgname=writeuppulse
pkgver=0.3.0
pkgrel=1
pkgdesc='Learn every day from popular technical writeups, summarized by Claude'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'systemd')
optdepends=('ollama: local tutor for questions and practice reviews (Ask tab)'
            'claude-code: run your own agent instead of reading the site')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/writeuppulse "$pkgdir/usr/bin/writeuppulse"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/writeuppulse.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/writeuppulse.svg"
  install -Dm644 "$startdir/writeuppulse.desktop" "$pkgdir/usr/share/applications/writeuppulse.desktop"
  install -Dm644 "$startdir/writeuppulse.service" "$pkgdir/usr/lib/systemd/user/writeuppulse.service"
  install -Dm644 "$startdir/writeuppulse.timer" "$pkgdir/usr/lib/systemd/user/writeuppulse.timer"
}
