#!/usr/bin/env python3
"""Builds src/references/references.json from MITRE ATT&CK (Enterprise), CWE,
CAPEC, and the OWASP Top Ten 2025 groupings inside CWE.

    bin/references            # downloads the current releases
    bin/references DIR        # uses enterprise-attack.json, cwec_*.xml, capec*.xml in DIR

Only the standard library. The output keeps each entry's short description,
official link, the phrases the app looks for in writeups, and the catalogs'
own relations (CWE parent, CWE <-> CAPEC, CAPEC -> ATT&CK, OWASP -> CWE,
sub-technique -> technique). Commit the result; the app reads it from its
resources and never downloads anything itself.
"""

import glob
import io
import json
import os
import re
import sys
import tempfile
import urllib.request
import xml.etree.ElementTree as ET
import zipfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "src", "references", "references.json")
SOURCES = {
    "attack": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json",
    "cwe": "https://cwe.mitre.org/data/xml/cwec_latest.xml.zip",
    "capec": "https://capec.mitre.org/data/xml/capec_latest.xml",
}

# Names too general to stand for one entry when they turn up in a writeup.
GENERIC = {
    "at", "tool", "server", "malware", "domains", "hardware", "dns", "ssh", "dll", "python", "lua", "botnet",
    "proxy", "cron", "trap", "cdns", "ntds", "whois", "add-ins", "javascript", "powershell", "applescript",
    "unix shell", "visual basic", "web services", "cloud accounts", "local accounts", "domain accounts",
    "default accounts", "email accounts", "social media accounts", "code repositories", "web protocols",
    "file transfer protocols", "mail protocols", "network devices", "digital certificates", "vulnerabilities",
    "exploits", "artificial intelligence", "serverless", "virtual private server", "container administration command",
    "systemd service", "systemd timers", "scheduled task", "launch agent", "launch daemon", "services",
    "web portal capture", "gui input capture", "credential api hooking", "local data staging",
    "remote data staging", "archive via utility", "archive via library", "archive via custom method",
    "data obfuscation", "junk data", "protocol impersonation", "one-way communication",
    "bidirectional communication", "dead drop resolver", "internal proxy", "external proxy", "multi-hop proxy",
    "file deletion", "network share connection removal", "clear command history",
    "embedded payloads", "binary padding", "software packing", "dynamic api resolution", "stripped payloads",
    "fileless storage", "command obfuscation", "encrypted/encoded file", "spearphishing link",
    "injection", "authentication", "authorization", "encryption", "privilege", "configuration", "logging",
    "debugging", "signing", "exposure", "reflection", "information exposure", "resource exhaustion",
}
# Other names and abbreviations that mean something else in most writeups.
GENERIC |= {"multi factor authentication", "windows", "stack overflow", "dead code", "memory leak", "alist", "css",
            "ear", "ecn", "fsms", "maid", "noc", "phi", "php", "ppi", "soc", "wildcard", "bias", "knob", "hitl", "isn",
            "snmp", "npd", "npe", "ssi", "xfs", "symlink"}
# Short names that still stand for one thing each.
KEEP = {"phishing", "rootkit", "bootkit", "path traversal", "keylogging", "steganography", "html smuggling",
        "domain fronting", "kerberoasting", "dcsync", "timestomp", "masquerading"}
MAX_WORDS = 6


def fetch(url):
    request = urllib.request.Request(url, headers={"User-Agent": "writeuppulse-references"})
    with urllib.request.urlopen(request, timeout=120) as response:
        return response.read()


def norm(text):
    """Lowercase words: "Use-after-free" is "use after free", "isn't" is "isnt"."""
    return " ".join(re.sub(r"[^\w]+", " ", re.sub(r"['’]", "", text.lower())).split())


def short(text, limit=420):
    """First paragraph, citations and markup out, cut at a sentence."""
    text = re.sub(r"\(Citation:[^)]*\)", "", text or "")
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"<[^>]+>", "", text)
    text = " ".join(text.split("\n\n")[0].split())
    if len(text) <= limit:
        return text
    cut = text[:limit]
    end = max(cut.rfind(". "), cut.rfind("; "))
    return (cut[: end + 1] if end > limit // 2 else cut.rsplit(" ", 1)[0] + "…").strip()


def text_of(node):
    return " ".join("".join(node.itertext()).split()) if node is not None else ""


def matchable(name):
    key = norm(name)
    words = key.split()
    if not words or len(words) > MAX_WORDS or len(key) < 3:
        return False
    if key in KEEP:
        return True
    return key not in GENERIC and (len(words) > 1 or (len(key) >= 8 and not key.isalpha()) or name.isupper())


def terms_of(name, extra=()):
    """The entry's name, its name without a parenthetical, and an acronym in it."""
    found = []
    for candidate in [name, *extra]:
        base = re.sub(r"\s*\([^)]*\)", "", candidate).strip()
        for term in (candidate, base):
            if matchable(term) and term not in found:
                found.append(term)
        for acronym in re.findall(r"\(([A-Z][A-Za-z0-9]{1,7})\)", candidate):
            if len(acronym) >= 3 and norm(acronym) not in GENERIC and acronym not in found:
                found.append(acronym)
    return found


def attack(path):
    objects = json.load(open(path, encoding="utf-8"))["objects"]
    entries = {}
    for o in objects:
        if o["type"] != "attack-pattern" or o.get("revoked") or o.get("x_mitre_deprecated"):
            continue
        ref = next(r for r in o["external_references"] if r.get("source_name") == "mitre-attack")
        tid = ref["external_id"]
        parent = tid.split(".")[0] if "." in tid else None
        entries[tid] = {
            "id": tid, "kind": "technique", "name": o["name"], "text": short(o.get("description")),
            "url": ref["url"], "terms": terms_of(o["name"]) if not parent or len(o["name"].split()) > 1 or norm(o["name"]) in KEEP else [],
            "related": [parent] if parent else [],
            "tactics": sorted({p["phase_name"] for p in o.get("kill_chain_phases", [])}),
        }
    return entries


def cwe(path):
    root = ET.parse(path).getroot()
    ns = {"c": root.tag.split("}")[0][1:]}
    entries, owasp = {}, {}
    for w in root.iter("{%s}Weakness" % ns["c"]):
        if w.get("Status") == "Deprecated":
            continue
        wid = "CWE-" + w.get("ID")
        alternates = [text_of(t.find("c:Term", ns)) for t in w.findall("c:Alternate_Terms/c:Alternate_Term", ns)]
        related = ["CWE-" + r.get("CWE_ID") for r in w.findall("c:Related_Weaknesses/c:Related_Weakness", ns)
                   if r.get("Nature") == "ChildOf" and r.get("View_ID") == "1000"]
        related += ["CAPEC-" + r.get("CAPEC_ID") for r in w.findall("c:Related_Attack_Patterns/c:Related_Attack_Pattern", ns)]
        # CWE's own names are long ("Improper Neutralization of Input During
        # Web Page Generation"); its common name ("Cross-site Scripting") reads better.
        common = [text_of(t.find("c:Term", ns)) for t in w.findall("c:Alternate_Terms/c:Alternate_Term", ns)
                  if any(text_of(r) == "Common-Name" for r in t.findall("c:Role", ns))]
        label = w.get("Name")
        quoted = re.search(r"\('([^']+)'\)", label)
        short_common = [t for t in common if len(t.split()) <= 5]
        if len(label.split()) <= 4:
            pass
        elif short_common:
            label = short_common[0]
        elif quoted:
            label = quoted.group(1)
        elif len(label.split()) > 5:
            label = next((t for t in common + alternates if 1 < len(t.split()) <= 5 or (len(t) >= 3 and t.isupper())), label)
            label = label[:1].upper() + label[1:]
        entries[wid] = {
            "id": wid, "kind": "weakness", "name": label, **({"title": w.get("Name")} if label != w.get("Name") else {}), "text": short(text_of(w.find("c:Description", ns))),
            "url": "https://cwe.mitre.org/data/definitions/%s.html" % w.get("ID"),
            "terms": terms_of(w.get("Name"), alternates) + [wid], "related": sorted(set(related)),
            "likelihood": text_of(w.find("c:Likelihood_Of_Exploit", ns)),
        }
    for g in root.iter("{%s}Grouping" % ns["c"]):
        m = re.match(r"OWASP Top Ten 2025 Category (A\d\d):2025 - (.*)", g.get("Name", ""))
        if not m:
            continue
        oid = m.group(1) + ":2025"
        members = ["CWE-" + h.get("CWE_ID") for h in g.iter("{%s}Has_Member" % ns["c"])]
        owasp[oid] = {
            "id": oid, "kind": "owasp", "name": m.group(2), "text": short(text_of(g.find("c:Summary", ns))),
            "url": "https://owasp.org/Top10/2025/", "terms": [oid] + (terms_of(m.group(2)) if len(m.group(2).split()) > 1 else []),
            "related": [x for x in members if x in entries],
        }
    return entries, owasp


def capec(path):
    root = ET.parse(path).getroot()
    ns = {"c": root.tag.split("}")[0][1:]}
    entries = {}
    for a in root.iter("{%s}Attack_Pattern" % ns["c"]):
        if a.get("Status") == "Deprecated":
            continue
        aid = "CAPEC-" + a.get("ID")
        related = ["CWE-" + r.get("CWE_ID") for r in a.findall("c:Related_Weaknesses/c:Related_Weakness", ns)]
        for t in a.findall("c:Taxonomy_Mappings/c:Taxonomy_Mapping", ns):
            entry = text_of(t.find("c:Entry_ID", ns))
            if t.get("Taxonomy_Name") == "ATTACK" and entry:
                related.append("T" + entry.lstrip("T"))
        skills = [s.get("Level") for s in a.findall("c:Skills_Required/c:Skill", ns) if s.get("Level")]
        entries[aid] = {
            "id": aid, "kind": "pattern", "name": a.get("Name"), "text": short(text_of(a.find("c:Description", ns))),
            "url": "https://capec.mitre.org/data/definitions/%s.html" % a.get("ID"),
            "terms": terms_of(a.get("Name")) + [aid], "related": sorted(set(related)),
            "severity": text_of(a.find("c:Typical_Severity", ns)),
            # The easiest skill level the pattern names: Low suits a beginner.
            "skill": min(skills, key=["Low", "Medium", "High"].index) if skills else "",
        }
    return entries, root.get("Version")


def main():
    directory = sys.argv[1] if len(sys.argv) > 1 else tempfile.mkdtemp(prefix="writeuppulse-references-")
    if len(sys.argv) == 1:
        print("Downloading into", directory)
        open(os.path.join(directory, "enterprise-attack.json"), "wb").write(fetch(SOURCES["attack"]))
        zipfile.ZipFile(io.BytesIO(fetch(SOURCES["cwe"]))).extractall(directory)
        open(os.path.join(directory, "capec.xml"), "wb").write(fetch(SOURCES["capec"]))
    attack_path = glob.glob(os.path.join(directory, "*attack*.json"))[0]
    cwe_path = glob.glob(os.path.join(directory, "cwec_*.xml"))[0]
    capec_path = glob.glob(os.path.join(directory, "capec*.xml"))[0]

    techniques = attack(attack_path)
    weaknesses, owasp = cwe(cwe_path)
    patterns, capec_version = capec(capec_path)
    entries = {**techniques, **weaknesses, **patterns, **owasp}
    for e in entries.values():
        e["related"] = [r for r in e["related"] if r in entries and r != e["id"]]
    # A phrase belongs to one entry: a technique first, then a weakness, then
    # an attack pattern, so "Cross-Site Scripting" is CWE-79, not also CAPEC-63.
    claimed = set()
    for e in sorted(entries.values(), key=lambda e: ["technique", "weakness", "pattern", "owasp"].index(e["kind"])):
        kept = []
        for term in e["terms"]:
            key = norm(term)
            if key and key not in claimed:
                claimed.add(key)
                kept.append(term)
        e["terms"] = kept

    cwe_version = re.search(r"cwec_v([\d.]+)\.xml", cwe_path)
    result = {
        "notice": "MITRE ATT&CK, CWE, and CAPEC are © The MITRE Corporation, reproduced and distributed with its "
                  "permission under their terms of use (attack.mitre.org/resources/legal-and-branding/terms-of-use, "
                  "cwe.mitre.org/about/termsofuse.html, capec.mitre.org/about/termsofuse.html). The OWASP Top Ten "
                  "2025 grouping comes from CWE's view 1450; OWASP Top Ten is © the OWASP Foundation, CC BY-SA 4.0.",
        "versions": {"cwe": cwe_version.group(1) if cwe_version else "", "capec": capec_version,
                     "attack": max((o.get("x_mitre_version", "") for o in json.load(open(attack_path))["objects"]
                                    if o["type"] == "x-mitre-collection"), default="")},
        "entries": sorted(entries.values(), key=lambda e: e["id"]),
    }
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, separators=(",", ":"))
    counts = {k: sum(1 for e in entries.values() if e["kind"] == k) for k in ("technique", "weakness", "pattern", "owasp")}
    print("Wrote", OUT, os.path.getsize(OUT) // 1024, "KB", counts, result["versions"])


if __name__ == "__main__":
    main()
